@startuml
!pragma layout smetana
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam classBackgroundColor #F3F6FA
skinparam classBorderColor #40566D
skinparam ArrowColor #40566D
hide circle
title Служебные данные SQLHunt
entity "Пользователь\nusers · сервис ID" as User {
  * id <<PK>>
  --
  * username <<UNIQUE>>
  * email <<UNIQUE>>
  * password_hash
  * role
}
entity "Профиль игрока\nplayer_profiles" as Profile {
  * user_id <<PK, ID пользователя>>
  --
  * xp
}
entity "Прогресс по делу\nuser_progress" as Progress {
  * user_id <<PK, FK>>
  * case_id <<PK, FK>>
  --
  * status
}
entity "Учебное дело\ninvestigation_cases" as Case {
  * id <<PK>>
  --
  * title
  * description
  * short_description
  * required_xp
  * reward_xp
  * answer
}
entity "Доступная таблица\ninvestigation_case_tables" as Table {
  * case_id <<PK, FK>>
  * table_name <<PK>>
}
entity "Задание SQL\nquery_jobs" as Job {
  * id <<PK>>
  * user_id <<FK>>
  * case_id <<FK>>
  --
  * query_text
  * status
  * result_json
  * error
}
User ||..o| Profile
Profile ||--o{ Progress
Case ||--o{ Progress
Case ||--|{ Table
Profile ||--o{ Job
Case ||--o{ Job
note bottom of Profile
  xp >= 0
  Профиль создаётся при первом
  обращении к игровому сервису.
end note
note bottom of Progress
  Пара (user_id, case_id) уникальна.
  Статусы — «не начато»,
  «в процессе», «завершено».
  Завершение и XP изменяются
  в одной транзакции.
end note
note right of Table
  table_name задаёт разрешение
  на таблицу учебной базы.
  Это логическая связь
  между хранилищами.
end note
legend bottom
  PK — первичный ключ, FK — внешний ключ, UNIQUE — уникальное значение.
  Пунктир — логическая связь с сервисом ID, без межбазового FK.
endlegend
@enduml
