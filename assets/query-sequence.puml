@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor #40566D
skinparam sequenceParticipantBackgroundColor #E3EAF3
skinparam sequenceParticipantBorderColor #40566D
skinparam sequenceGroupBackgroundColor #F3F6FA
skinparam maxMessageSize 200
hide footbox
title Асинхронное выполнение SQL-запроса
participant "Веб-клиент\nигрока" as Client
participant "Игровой API\nGo" as API
database "Игровая БД\nPostgreSQL" as DB
queue "Очередь SQL-заданий\nRabbitMQ" as Queue
participant "SQL-движок\nGo" as Engine
note over Client, API
  Игрок вошёл через ID и выбрал дело.
  Клиент отправляет токен доступа.
end note
Client -> API : Выполнить SQL для выбранного дела
API -> API : Проверить токен доступа
break Токен недействителен
  API --> Client : Запросить повторный вход
end
API -> DB : Получить дело, XP и разрешённые таблицы
DB --> API : Условия доступа и ограничения
API -> API : Проверить XP, SELECT и таблицы
break Запрос отклонён
  API --> Client : Причина отказа
end
API -> DB : Сохранить запрос, владельца и дело
DB --> API : Номер задания
API -> Queue : Передать номер задания
break Очередь недоступна
  API -> DB : Отметить задание как не принятое
  API --> Client : Предложить повторить попытку позже
end
API --> Client : Принято, номер задания
par Обработка задания
Queue ->> Engine : Передать номер задания
Engine -> DB : Получить запрос и разрешения дела
DB --> Engine : Запрос и актуальные ограничения
Engine -> Engine : Проверить запрос и выполнить\nв изолированной учебной среде
note over Queue, Engine
  Учебная БД PostgreSQL, только чтение разрешённых таблиц.
  Не более 3 секунд и 1 000 строк.
end note
alt Успешное выполнение
  Engine -> DB : Сохранить строки, колонки и признак усечения
else Запрос запрещён, ошибка SQL или истёк лимит
  Engine -> DB : Сохранить ошибку выполнения
end
else Опрос состояния клиентом
loop Пока задание ожидает или выполняется
  Client -> API : Получить состояние по номеру с токеном
  API -> API : Проверить токен
  API -> DB : Найти задание по номеру и владельцу
  DB --> API : Состояние и результат либо отсутствие записи
  API --> Client : Состояние, результат, ошибка или отказ
end
end
@enduml
