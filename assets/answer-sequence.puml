@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor #40566D
skinparam sequenceParticipantBackgroundColor #E3EAF3
skinparam sequenceParticipantBorderColor #40566D
skinparam sequenceGroupBackgroundColor #F3F6FA
skinparam maxMessageSize 230
hide footbox
title Проверка ответа и начисление опыта
participant "Веб-клиент\nигрока" as Client
participant "Игровой API\nGo" as API
database "Игровая БД\nPostgreSQL" as DB

Client -> API : Отправить ответ по делу с токеном
API -> API : Проверить токен доступа
break Токен недействителен
  API --> Client : Запросить повторный вход
end
group Транзакция завершения дела
  API -> DB : Начать транзакцию, заблокировать профиль
  API -> DB : Прочитать дело и прогресс игрока
  DB --> API : XP, порог, награда, контрольный ответ и статус
  break Дело недоступно по XP
    API -> DB : Откатить транзакцию
    API --> Client : Сообщить об ограничении доступа
  end
  API -> API : Сравнить ответ и проверить статус дела
  alt Первый правильный ответ
    API -> DB : Сохранить завершение и увеличить XP
  else Повторный правильный ответ
    API -> API : Подтвердить решение без начисления XP
  else Неверный ответ
    API -> API : Отклонить ответ
  end
  API -> DB : Зафиксировать транзакцию
  DB --> API : Транзакция завершена
end
API --> Client : Результат проверки ответа
opt Ответ верен
  Client -> API : Запросить обновлённый каталог
  API -> DB : Прочитать XP, дела и статусы
  DB --> API : Данные каталога
  API --> Client : XP, прогресс и доступность дел
end
@enduml
