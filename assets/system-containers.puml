@startuml
!pragma layout smetana
!include <C4/C4_Container>
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam backgroundColor white
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 45
title C4 · Контейнеры SQLHunt

Person(player, "Игрок", "Решает учебные дела")
Person(editor, "Редактор", "Управляет учебными делами")

System_Boundary(sqlhunt, "SQLHunt") {
  Container(web, "Веб-клиент", "Веб-приложение", "Каталог, SQL-редактор, схема базы")
  Container(admin, "Панель редактора", "Django", "Управление делами")
  Container(identity, "Сервис ID", "Go", "Учётные записи, роли и токены")
  Container(game, "Игровой сервис", "Go", "Условия дел, запросы, проверка ответов и прогресс")
  Container(engine, "SQL-движок", "Go", "Выполнение SQL с ограничениями доступа, времени и вывода")
  Container(generator, "Генератор данных", "Самостоятельный модуль", "Подготовка синтетического архива по заданным параметрам")
  ContainerQueue(jobs, "Очередь заданий", "RabbitMQ", "Передача номеров SQL-заданий")
  ContainerDb(accounts, "База учётных записей", "PostgreSQL", "Пользователи и роли")
  ContainerDb(gameData, "Игровая база", "PostgreSQL", "Дела, прогресс, XP и результаты SQL")
  ContainerDb(training, "Полицейский архив", "PostgreSQL", "Учебные данные и метаданные")
}

Rel_D(player, web, "Проходит дела", "HTTPS")
Rel_D(editor, admin, "Редактирует дела", "HTTPS")
Rel_D(web, identity, "Регистрация и вход", "HTTPS")
Rel_D(admin, identity, "Вход и получение роли", "HTTPS")
Rel_D(web, game, "Схема, запросы и ответы", "HTTPS")
Rel_D(admin, game, "Изменяет условия дел", "HTTPS")
Rel_D(identity, accounts, "Читает и сохраняет учётные записи")
Rel_D(game, gameData, "Читает дела, сохраняет прогресс и задания")
Rel_D(game, jobs, "Публикует номера заданий")
Rel_D(jobs, engine, "Передаёт номера заданий")
Rel(engine, gameData, "Читает задания и сохраняет результаты")
Rel_D(engine, training, "Выполняет SELECT")
Rel(game, training, "Читает\nметаданные")
Rel_D(generator, training, "Записывает учебный набор")
@enduml
